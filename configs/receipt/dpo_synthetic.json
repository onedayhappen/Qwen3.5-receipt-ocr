{
  "model_id": "models/sft-merged",
  "parent_stage": "sft",
  "data_path": "data/receipt/exports/dpo_train_synthetic.json",
  "eval_path": "data/receipt/exports/dpo_dev_synthetic.json",
  "image_folder": "data/receipt",
  "eval_image_folder": "data/receipt",
  "output_dir": "models/dpo-synthetic-adapter",
  "lora_enable": true,
  "vision_lora": false,
  "use_dora": false,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_namespan_exclude": "['lm_head', 'embed_tokens', 'in_proj_qkv', 'visual']",
  "freeze_llm": true,
  "freeze_vision_tower": true,
  "freeze_merger": true,
  "bf16": true,
  "fp16": false,
  "disable_flash_attn2": true,
  "use_liger_loss": false,
  "loss_type": "sigmoid",
  "beta": 0.1,
  "precompute_ref_log_probs": false,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "gradient_checkpointing": true,
  "max_seq_length": 8192,
  "max_length": 8192,
  "image_min_pixels": 65536,
  "image_max_pixels": 1048576,
  "learning_rate": 0.000005,
  "num_train_epochs": 1,
  "logging_steps": 1,
  "eval_strategy": "epoch",
  "save_strategy": "epoch",
  "save_total_limit": 2,
  "remove_unused_columns": false,
  "report_to": "none",
  "seed": 42
}
